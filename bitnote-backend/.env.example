# Copy this file to .env and fill in whatever you need.
# Everything below is optional — the app runs with sensible defaults if unset.

# LLM provider: "ollama" (default — local, free, no API key needed) or
# "gemini" (hosted — needs GEMINI_API_KEY below).
LLM_PROVIDER=ollama

# Used when LLM_PROVIDER=ollama. Requires `ollama pull <model>` first.
OLLAMA_MODEL=gemma3

# Used when LLM_PROVIDER=gemini — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# JWT signing key for login sessions. Falls back to an insecure dev key
# (with a startup warning) if unset — set this to a long random value
# before deploying anywhere real.
BITNOTE_SECRET_KEY=

# Overrides the default SQLite file location
# (<repo>/bitnote-backend/bitnote/database/bitnote.db).
BITNOTE_DB_PATH=

# Overrides the default Firebase Admin credential path
# (<repo>/bitnote-backend/firebase_key.json).
FIREBASE_KEY_PATH=

# Comma-separated list of allowed frontend origins for CORS.
# Defaults to localhost:5500,localhost:3000,127.0.0.1:5500,127.0.0.1:3000
BITNOTE_CORS_ORIGINS=
